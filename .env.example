# Copy this file to `.env` for local use.
# Never commit `.env` with real secrets.

APP_ENV=prod
DB_PATH=Actigraph_record.db
# Request from NCBI account settings:
# https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=replace_with_ncbi_api_key
ALLOWED_MODELS=phi4:14b,llama3.2,qwen3.5:9b
# Optional cloud LLMs ("provider/model"). A provider appears in the app only
# when its API key is set. Cloud models receive metrics and any anamnesis.
CLOUD_MODELS=anthropic/claude-sonnet-5-5,anthropic/claude-opus-5-5,openai/gpt-4.1,gemini/gemini-2.5-flash
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOCKOUT_MINUTES=15
SHOW_RAW_PIPELINE_TRACES=0
# Generate with:
# openssl rand -hex 32
DB_BACKUP_KEY=replace_with_random_64_hex_chars
